@model Model.Models.TrackingDocument.TrackingDocModel
@{
    ViewBag.Title = "TrackDocument";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/select2.min.css" rel="stylesheet" />
<style>
    .form-control {
        height: 35px;
    }

    .select2-container .select2-selection--single {
        height: 35px !important;
    }

    .select2-selection__rendered {
        line-height: 33px !important;
        padding-left: 15px !important;
    }
    .select2-selection__arrow b{
        margin-top : auto !important;
    }
   @* .select2-selection__arrow:before {
        content: ''; /* Unicode for downward arrow */
        font-size: 18px;
        color: #007bff; /* Customize the color */
    }*@
</style>
<div class="card">
    <div class="breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"> <em class="fa fa-home"></em></li>
                <li class="breadcrumb-item"><a href="/">Document Tracking</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add</li>
            </ol>
        </nav>
    </div>
</div>

@using (Html.BeginForm("Save", "TrackDocument", FormMethod.Post, new { @enctype = "multipart/form-data" }))
{
    <div class="panel panel-default articles">
        <div class="panel-body">
            <div class="row">

                <div class="col-12 tab-content">
                    <div class="row">

                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.SenderOrgName)" class="control-label  lfz">Sender's Name/ Organization</label>
                            @Html.EditorFor(m => m.SenderOrgName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.SenderOrgName, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.DocType)" class="control-label  lfz">Document Type</label>
                            @Html.DropDownListFor(m => m.DocType, (SelectList)ViewBag.TypeDoc, "--  Select Type --", new { @class = "form-control", @id = "othS_DT" })
                            @Html.ValidationMessageFor(m => m.DocType, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4" id="othDT" hidden>
                            <label for="@Html.IdFor(m => m.OtherDocType)" class="control-label">Other Document Type</label>
                            @Html.EditorFor(m => m.OtherDocType, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.OtherDocType, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.ReceivedDate)" class="control-label  lfz">Received Date</label>
                            @Html.EditorFor(m => m.ReceivedDate, new { htmlAttributes = new { @class = "form-control", @max = DateTime.Now.ToString("yyyy-MM-dd") } })
                            @Html.ValidationMessageFor(m => m.ReceivedDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.Subject)" class="control-label  lfz">Subject</label>
                            @Html.EditorFor(m => m.Subject, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.DocumentStatus)" class="control-label  lfz">Document Status</label>
                            @Html.DropDownListFor(m => m.DocumentStatus, new SelectList(ViewBag.DocStatus, "Value", "Text", "54"), new { @class = "form-control", @disabled = "disabled" })
                            @Html.ValidationMessageFor(m => m.DocumentStatus, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.DocSummary)" class="control-label  lfz">Document Summary</label>
                            @Html.EditorFor(m => m.DocSummary, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.DocSummary, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.ActionDate)" class="control-label  lfz">Action Date</label>
                            @Html.EditorFor(m => m.ActionDate, new { htmlAttributes = new { @class = "form-control", @min = DateTime.Now.ToString("yyyy-MM-dd") } })
                            @Html.ValidationMessageFor(m => m.ActionDate, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.RequiredAction)" class="control-label  lfz">Action Required</label>
                            @Html.DropDownListFor(m => m.RequiredAction, (SelectList)ViewBag.ActionReq, "--  Select Action --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.RequiredAction, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.RequiredAttention)" class="control-label  lfz">Attention Required</label>
                            @Html.DropDownListFor(m => m.RequiredAttention, (SelectList)ViewBag.AttentionStatus, "--  Select Attention --", new { @class = "form-control", @id = "othS_AR" })
                            @Html.ValidationMessageFor(m => m.RequiredAttention, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4" id="othAR" hidden>
                            <label for="@Html.IdFor(m => m.CCMailIds)" class="control-label">Other's Attention Required</label>
                            @Html.EditorFor(m => m.CCMailIds, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(m => m.CCMailIds, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.DetailedDescription)" class="control-label  lfz">Detailed Description</label>
                            @Html.TextAreaFor(m => m.DetailedDescription, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DetailedDescription, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.AttachDoc)" class="control-label  lfz">Attach Document</label>
                            @Html.TextBoxFor(m => m.AttachDoc, new { @class = "form-control", @type = "file", @multiple = "multiple", @id = "attDoc" })
                            @Html.ValidationMessageFor(m => m.AttachDoc, "", new { @class = "text-danger" })
                            <span id="selectedFile"></span>
                        </div>
                        <div class="form-group lfzab col-md-4">
                            <label for="@Html.IdFor(m => m.RecipientMailId)" class="control-label  lfz">Recipient's Email Id</label>
                            @Html.DropDownListFor(m => m.RecipientMailId, (SelectList)ViewBag.RecipientList, "--  Select Recipient --", new { @id = "idls", @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.RecipientMailId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-6 mx-auto">
                            <button type="submit" class="btn btn-primary">Submit</button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
<script src="~/Scripts/select2.min.js"></script>
<script>

    $(document).ready(function () {
        $('#idls').select2();

        var mssg = "@TempData["Update"]";
        if (mssg.length > 0) {
            showSweetAlert(mssg, '', 'success');
        }
    });

    var divODT = $("#othDT").children().detach();
    var divOAR = $("#othAR").children().detach();

    $("#othS_DT").change(function () {
        if ($(this).val() == 54) { $("#othDT").show(); $("#othDT").append(divODT); }
        else { $("#othDT").hide(); $("#othDT").children().remove(); }
    });

    $("#othS_AR").change(function () {
        if ($(this).val() == 54) { $("#othAR").show(); $("#othAR").append(divOAR); }
        else { $("#othAR").hide(); $("#othAR").children().remove(); }
    })


</script>