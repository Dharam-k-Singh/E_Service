    $(document).ready(function () {
    // Set inputs and textareas to readonly
    $('input,textarea').attr('readonly', 'readonly');

    // Pass the comma-separated email string from Razor to JavaScript
    var mailIds = '@Html.Raw(Json.Encode(Model.ToMailIds))';  // Safely inject the string
        mailIds = mailIds.replace(/"/g, '');

    // Split the string into an array of email addresses
    mailIds = mailIds.split(',');

    // Log mailIds for debugging
    console.log(mailIds);

    // Append email addresses to the #mailIds element
    mailIds.forEach(function (mailId, index) {
        console.log(mailId);  // Log each email address for debugging
        $("#mailIds").append((index + 1) + ". " + mailId + "<br>");
    });
});
</script>

